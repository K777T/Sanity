---
import { getVideos } from "../../lib/queries";

export async function getStaticPaths() {
  const videos = await getVideos();

  return videos
    .filter((video) => video.slug)
    .map((video) => ({
      params: {
        slug: video.slug,
      },
      props: {
        video,
      },
    }));
}

const { video } = Astro.props;

if (!video) {
  return Astro.redirect("/");
}

console.log("🔥 STATIC WATCH PAGE:", video.slug);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{video.title}</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: Arial, sans-serif;
        background: #0f0f23;
        color: white;
      }

      .header {
        height: 72px;
        display: flex;
        align-items: center;
        padding: 0 25px;
        background: #1a1a2e;
        border-bottom: 1px solid #252545;
      }

      .logo {
        color: #00d4aa;
        font-size: 21px;
        font-weight: bold;
        text-decoration: none;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 30px 20px;
      }

      .back {
        display: inline-block;
        margin-bottom: 20px;
        color: #aaa;
        text-decoration: none;
      }

      .back:hover {
        color: white;
      }

      .player {
        width: 100%;
        background: #000;
        border-radius: 12px;
        overflow: hidden;
      }

      .player iframe {
        display: block;
        width: 100%;
        height: 600px;
        border: 0;
      }

      .title {
        margin-top: 25px;
        font-size: 30px;
      }

      .description {
        margin-top: 12px;
        color: #aaa;
        line-height: 1.6;
      }

      .meta {
        display: flex;
        gap: 15px;
        margin-top: 15px;
        color: #888;
      }

      .servers {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
      }

      .server-btn {
        padding: 10px 16px;
        border: 0;
        border-radius: 7px;
        background: #252545;
        color: white;
        cursor: pointer;
        transition: 0.2s ease;
      }

      .server-btn:hover {
        background: #00d4aa;
        color: #071b18;
      }

      .server-btn.active {
        background: #00d4aa;
        color: #071b18;
      }

      @media (max-width: 700px) {
        .container {
          padding: 20px 15px;
        }

        .player iframe {
          height: 400px;
        }

        .title {
          font-size: 24px;
        }

        .server-btn {
          flex: 1;
          min-width: 120px;
        }
      }
    </style>
  </head>

  <body>
    <header class="header">
      <a href="/" class="logo">▶ ViralDekho</a>
    </header>

    <main class="container">
      <a href="/" class="back">← Back to Videos</a>

      <!-- VIDEO PLAYER -->

      <div class="player">
        {
          video.server1Url && (
            <iframe
              id="videoPlayer"
              src={video.server1Url}
              title={video.title}
              allowfullscreen
            />
          )
        }
      </div>

      <!-- TITLE -->

      <h1 class="title">
        {video.title}
      </h1>

      <!-- DESCRIPTION -->

      {video.description && <p class="description">{video.description}</p>}

      <!-- META -->

      <div class="meta">
        <span>
          {video.category || "Video"}
        </span>

        {
          typeof video.rating === "number" && (
            <span>⭐ {video.rating.toFixed(1)}</span>
          )
        }
      </div>

      <!-- SERVERS -->

      <div class="servers">
        {
          video.server1Url && (
            <button
              class="server-btn active"
              onclick={`switchServer('${video.server1Url}', this)`}
            >
              Server 1
            </button>
          )
        }

        {
          video.server2Url && (
            <button
              class="server-btn"
              onclick={`switchServer('${video.server2Url}', this)`}
            >
              Server 2
            </button>
          )
        }

        {
          video.server3Url && (
            <button
              class="server-btn"
              onclick={`switchServer('${video.server3Url}', this)`}
            >
              Server 3
            </button>
          )
        }

        {
          video.server4Url && (
            <button
              class="server-btn"
              onclick={`switchServer('${video.server4Url}', this)`}
            >
              Server 4
            </button>
          )
        }
      </div>
    </main>

    <!-- SERVER SWITCHING -->

    <script>
      function switchServer(url, button) {
        const player = document.getElementById("videoPlayer");

        if (!player || !url) {
          return;
        }

        player.src = url;

        document
          .querySelectorAll(".server-btn")
          .forEach((btn) => btn.classList.remove("active"));

        button.classList.add("active");
      }
    </script>
  </body>
</html>
